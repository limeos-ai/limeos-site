# limeos.ai on Railway. Railway handles HTTPS and forwards plain HTTP to $PORT.
# Serves the site the way GitHub Pages did: /services/how-it-works answers with
# how-it-works.html, a folder asked for without its slash (/services) redirects
# to /services/, and www.limeos.ai redirects to limeos.ai.
{
	admin off
	auto_https off
	persist_config off
}

:{$PORT:8080} {
	@www host www.limeos.ai
	redir @www https://limeos.ai{uri} permanent

	root * {$SITE_ROOT:/srv}
	encode zstd gzip
	header Cache-Control "public, max-age=600"
	try_files {path} {path}.html
	file_server
}
